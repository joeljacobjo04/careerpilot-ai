PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/careerpilot
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES=7d
CLIENT_URL=http://localhost:5173
# Officers must enter this code when registering
OFFICER_INVITE_CODE=CAREERPILOT-OFFICER
# Free key from https://console.groq.com
GROQ_API_KEY=
# Model names change often. Check https://console.groq.com/docs/models
GROQ_MODEL=llama-3.3-70b-versatile

# Phone/browser push (generate with `npm run vapid`)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:placement@yourcollege.edu

# Email alerts via Brevo (free: 300 emails/day). Create a key at app.brevo.com > SMTP & API
BREVO_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=CareerPilot

# Registration sends a 6-digit code to the person's email (uses the Brevo settings above).
# Without Brevo, in development the code is printed in the server console; in production registration is blocked.
OTP_EXPIRY_MINUTES=10

# --- Load handling (all optional) ---
# Number of proxies in front of the server (Render/Vercel/nginx = 1). Use 0 if the server is exposed directly.
TRUST_PROXY=1
# Requests per IP per 15 minutes on /api/auth (a whole class on one Wi-Fi shares one IP)
AUTH_RATE_LIMIT=600
OTP_IP_RATE_LIMIT=300
# bcrypt cost for new passwords (10 is fast and still safe; existing passwords keep working)
BCRYPT_ROUNDS=10
